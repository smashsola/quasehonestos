{
  "name": "quasehonestos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "previews": {
    "ai": {
      "binding": "Workers_AI"
    }
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  }
}
