{
  "name": "quasehonestos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "ai": {"binding": "Workers_AI"},
  "vars": {"DIALOGUE_AI_ENABLED": "false"},
  "build": {"command": "npm run build"},
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]}
}
